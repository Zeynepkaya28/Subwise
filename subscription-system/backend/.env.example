# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/subscription-analyzer

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PRO=price_...

# ── OpenAI (AI subscription analysis) ──────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Email (SMTP) ───────────────────────────────────────────
# Leave empty to use Ethereal fake SMTP in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SubSaver AI <noreply@subsaver.app>

# ── Encryption (AES-256-GCM for sensitive data at rest) ────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=

# ── Frontend URL (for Stripe redirects & email links) ──────
CLIENT_URL=http://localhost:3000
