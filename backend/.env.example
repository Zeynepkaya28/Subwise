# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finance
DATABASE_PASSWORD=finance
DATABASE_NAME=finance_secure

# Redis (rate limit / refresh JTI cache — optional for MVP)
REDIS_URL=redis://localhost:6379

# JWT (local tokens — use RS256 via external IdP in prod; see README)
JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=14

# AES-256 master key for application-layer encryption at rest (32 bytes, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=

# Optional OIDC (RS256 JWKS) — when set, Bearer tokens from IdP are accepted
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# TypeORM (set false in production)
TYPEORM_SYNC=true
